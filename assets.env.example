# Copy to assets.env, fill the paths, then the scripts source it automatically.
export VGGT_BASE_CHECKPOINT=/path/to/VGGT-1B/model.pt
export VGGT_HPE_CHECKPOINT=/path/to/checkpoint_305.pt
export BIWI_ROOT=/path/to/biwi/faces_0
export TORCH_CACHE=/path/to/torch/cache

# Training / synthetic evaluation only.
export SYNTHETIC_HAIR_ROOT=/path/to/dataset_20k_hair_v2
export SYNTHETIC_NOHAIR_ROOT=/path/to/ar_pose_poc_5k
